# =====================================================================
# RelayAB — you only need the first one. Everything else is optional.
# =====================================================================
#
# Vercel Deploy Button asks for RELAY_AUTH and nothing else. On Vercel the
# database comes from the Upstash Marketplace, and the public URL is derived
# from VERCEL_URL automatically.
#
# ---------------------------------------------------------------------
# 1. REQUIRED
# ---------------------------------------------------------------------
#
# Master secret. Doubles as the bootstrap admin's password, and seeds the
# session-encryption key and the AES key that protects upstream provider keys.
# Generate one with:  openssl rand -hex 32
#
RELAY_AUTH="<paste-your-openssl-rand-hex-32-output>"

# ---------------------------------------------------------------------
# 2. DATABASE (auto-injected by the Vercel Marketplace)
# ---------------------------------------------------------------------
#
# Vercel → Storage → Create Database → Upstash fills these in for you.
# Only set them by hand when self-hosting outside Vercel.
#
# UPSTASH_REDIS_REST_URL="https://<your-db>.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="<your-token>"

# =====================================================================
# 3. OPTIONAL — defaults are fine for most deployments
# =====================================================================
#
# --- Public URL ------------------------------------------------------
# Only needed if the URL your users should call differs from the one they
# reached this deployment on (custom domain in front of *.vercel.app, or a
# reverse proxy). Otherwise RelayAB derives it from VERCEL_URL or the
# incoming request — no configuration required.
#
# RELAY_PUBLIC_URL="https://relay.example.com"

# --- Admin account ---------------------------------------------------
# RELAY_ADMIN_USERNAME="admin"

# --- Interface language ----------------------------------------------
# Visitors can always switch languages from the footer; this is only the
# default they start with.
# RELAY_DEFAULT_LOCALE="zh-CN"

# --- Upstream providers ----------------------------------------------
# Set these to seed providers on first boot instead of adding them through
# the admin UI. Multiple keys (comma-separated) enable key rotation.
#
# OPENAI_KEYS="sk-xxx,sk-yyy"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# ANTHROPIC_KEYS="sk-ant-xxx"
# ANTHROPIC_BASE_URL="https://api.anthropic.com"

# --- Advanced --------------------------------------------------------
# Pin the AES master key so rotating RELAY_AUTH doesn't invalidate stored
# upstream keys (64 hex chars). Leave unset to derive it from RELAY_AUTH.
# RELAY_MASTER_KEY_HEX="<64-hex-chars>"
#
# Bypass Vercel Deployment Protection for server-internal API calls.
# VERCEL_PROTECTION_BYPASS="<value-from-vercel-dashboard>"
#
# Local development only: run against an in-process Redis mock + Vercel
# emulator instead of real infrastructure.
# EMULATE_VERCEL_LOCAL="1"
#
# GitHub link shown in the footer.
# NEXT_PUBLIC_REPOSITORY_URL="https://github.com/CloudyAasim/RelayAB"
