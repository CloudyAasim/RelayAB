# =====================================================================
# RelayAB — 环境变量配置
# =====================================================================
#
# 只需要配置 RELAY_AUTH 即可启动！
# 其他所有配置都有安全的默认值。
#
# 完整示例见 deploy/env.production.example（自托管生产环境）。
# =====================================================================

# ---------------------------------------------------------------------
# 1. 必需
# ---------------------------------------------------------------------
#
# 主密钥：用于管理员登录、Session加密、API密钥加密。
# 生成方法：openssl rand -hex 32
#
RELAY_AUTH="<在此粘贴 openssl rand -hex 32 的输出>"

# ---------------------------------------------------------------------
# 2. 数据库
# ---------------------------------------------------------------------
#
# 不需要配置任何数据库服务。SQLite 是 Node 24 内置模块（node:sqlite），
# 数据库就是一个文件：没有端口、没有密码、没有进程需要守护。
#
# 留空则写到 <工作目录>/data/relayab.db。生产环境建议显式指定，并把文件
# 放在发布目录之外，这样 git pull 和重建镜像都碰不到它。
#
# 容器部署时这里必须写容器内的挂载点，不是宿主机路径：
#   RELAY_DB_PATH=/data/relayab.db
#
# RELAY_DB_PATH="/var/lib/relayab/relayab.db"
#
# 部署前可以先跑一遍体检（会真的去试着创建目录、写探针文件）：
#   pnpm exec tsx scripts/check-env.ts

# =====================================================================
# 3. 可选配置（都有安全的默认值）
# =====================================================================

# --- 公开URL ---------------------------------------------------
# 只有当你需要让用户使用的URL与实际访问的URL不同时才需要设置
#（例如使用了自定义域名或反向代理）。大多数情况下不需要设置。
#
# RELAY_PUBLIC_URL="https://relay.example.com"

# --- 管理员账号 -------------------------------------------------
# 默认用户名是 "admin"，可以在此更改
# RELAY_ADMIN_USERNAME="admin"

# --- 界面语言 ---------------------------------------------------
# 默认语言：zh-CN（中文）或 en（英文）
# 用户可以在页脚随时切换语言
# RELAY_DEFAULT_LOCALE="zh-CN"

# --- 上游提供商 -------------------------------------------------
# 设置后会在首次启动时自动创建提供商
#
# OPENAI_KEYS="sk-xxx,sk-yyy"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# ANTHROPIC_KEYS="sk-ant-xxx"
# ANTHROPIC_BASE_URL="https://api.anthropic.com"

# --- 高级选项 ---------------------------------------------------
# 固定 AES 主密钥，这样修改 RELAY_AUTH 时不会使已存储的上游密钥失效
# RELAY_MASTER_KEY_HEX="<64位十六进制字符>"
#
# 自托管时记录当前版本，会出现在 /healthz 的 revision 字段
# （Dokku 部署不需要设，它会注入 DOKKU_GIT_REV）
# RELAY_BUILD_ID="v1"
#
# GitHub 链接（显示在页脚）
# NEXT_PUBLIC_REPOSITORY_URL="https://github.com/CloudyAasim/RelayAB"
