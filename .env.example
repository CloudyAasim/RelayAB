# =====================================================================
# RelayAB — 环境变量配置
# =====================================================================
#
# 只需要配置 RELAY_AUTH 即可启动！
# 其他所有配置都有安全的默认值，或者由 Vercel Marketplace 自动注入。
#
# ---------------------------------------------------------------------
# 1. 必需
# ---------------------------------------------------------------------
#
# 主密钥：用于管理员登录、Session加密、API密钥加密。
# 生成方法：openssl rand -hex 32
#
RELAY_AUTH="<在此粘贴 openssl rand -hex 32 的输出>"

# ---------------------------------------------------------------------
# 2. 数据库（由 Vercel Marketplace 自动注入）
# ---------------------------------------------------------------------
#
# 在 Vercel 上：Storage → 创建数据库 → Upstash 会自动填入以下值。
# 本地开发或自行部署时需要手动设置。
#
# UPSTASH_REDIS_REST_URL="https://<your-db>.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="<your-token>"

# =====================================================================
# 3. 可选配置（都有安全的默认值）
# =====================================================================

# --- 公开URL ---------------------------------------------------
# 只有当你需要让用户使用的URL与实际访问的URL不同时才需要设置
#（例如使用了自定义域名或反向代理）。大多数情况下不需要设置。
#
# RELAY_PUBLIC_URL="https://relay.example.com"

# --- 管理员账号 -------------------------------------------------
# 默认用户名是 "admin"，可以在此更改
# RELAY_ADMIN_USERNAME="admin"

# --- 界面语言 ---------------------------------------------------
# 默认语言：zh-CN（中文）或 en（英文）
# 用户可以在页脚随时切换语言
# RELAY_DEFAULT_LOCALE="zh-CN"

# --- 上游提供商 -------------------------------------------------
# 设置后会在首次启动时自动创建提供商
#
# OPENAI_KEYS="sk-xxx,sk-yyy"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# ANTHROPIC_KEYS="sk-ant-xxx"
# ANTHROPIC_BASE_URL="https://api.anthropic.com"

# --- 高级选项 ---------------------------------------------------
# 固定 AES 主密钥，这样修改 RELAY_AUTH 时不会使已存储的上游密钥失效
# RELAY_MASTER_KEY_HEX="<64位十六进制字符>"
#
# 绕过 Vercel 部署保护（用于内部 API 调用）
# VERCEL_PROTECTION_BYPASS="<来自 Vercel 仪表板的值>"
#
# 仅本地开发：使用内存中的 Redis 模拟器而不是真实的基础设施
# EMULATE_VERCEL_LOCAL="1"
#
# GitHub 链接（显示在页脚）
# NEXT_PUBLIC_REPOSITORY_URL="https://github.com/CloudyAasim/RelayAB"
