# =====================================================================
# RelayAB — required minimum (Vercel Deploy Button asks for RELAY_AUTH)
# =====================================================================
# Master secret. Used both as the bootstrap admin's password and to derive
# the AES-256 master key + iron-session password (via HMAC-SHA256).
# Generate one with:  openssl rand -hex 32
RELAY_AUTH="<paste-your-openssl-rand-hex-32-output>"

# =====================================================================
# Public base URL — shown to users in docs / dashboard
# =====================================================================
# The URL where THIS RelayAB instance is reachable from the public
# internet (e.g. https://relay.example.com). Users see this in their
# dashboard and copy it into their OpenAI/Anthropic-compatible clients.
# Set this at deploy time together with RELAY_AUTH.
RELAY_PUBLIC_URL="https://example.com"

# =====================================================================
# Upstash for Redis (auto-injected by Vercel Marketplace; or paste manually)
# =====================================================================
UPSTASH_REDIS_REST_URL="https://<your-db>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<your-token>"

# =====================================================================
# Optional overrides
# =====================================================================
# Admin login username (default: admin). Log in with RELAY_AUTH as password.
RELAY_ADMIN_USERNAME="admin"

# Default UI language. Visitors can still switch per-browser from the footer;
# this is only the default they start with.
#   "zh-CN"  Chinese (default)
#   "en"     English
RELAY_DEFAULT_LOCALE="zh-CN"

# Explicit AES-256 master key (64 hex chars). If omitted, derived from
# RELAY_AUTH. Set explicitly if you want to rotate RELAY_AUTH later
# without losing access to encrypted upstream provider keys.
# RELAY_MASTER_KEY_HEX="<64-hex-chars>"

# Auto-bootstrap upstream providers from environment. Multiple keys enable
# rotation (one provider per key).
OPENAI_KEYS="sk-xxx,sk-yyy"
OPENAI_BASE_URL="https://api.openai.com/v1"

ANTHROPIC_KEYS="sk-ant-xxx"
ANTHROPIC_BASE_URL="https://api.anthropic.com"

# Bypass Vercel Deployment Protection for server-internal Vercel SDK calls.
# VERCEL_PROTECTION_BYPASS="<value-from-vercel-dashboard>"

# Set to 1 in dev to use the in-process Redis mock + Vercel SDK emulator
# instead of real Upstash (default: 1 in non-production, 0 in production).
# EMULATE_VERCEL_LOCAL="0"

# GitHub repo link shown in the site footer (set to "" to hide).
# NEXT_PUBLIC_REPOSITORY_URL="https://github.com/CloudyAasim/RelayAB"
