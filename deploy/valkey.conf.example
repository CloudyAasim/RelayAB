# =====================================================================
# RelayAB — Valkey 配置片段
# =====================================================================
#
# Debian 13 (trixie) 官方源已内置 valkey-server（8.1.x），
# 因此不需要添加第三方仓库：
#
#   sudo apt update
#   sudo apt install -y valkey-server valkey-tools
#   sudo systemctl enable --now valkey-server
#   valkey-cli ping        # 期望 PONG
#
# 把下面几项合并进 /etc/valkey/valkey.conf 后重启：
#   sudo systemctl restart valkey-server

# ---------------------------------------------------------------------
# 1. 网络
# ---------------------------------------------------------------------
# 只监听回环地址。RelayAB 与 Valkey 同机，走本地 socket 即可。
# ⚠️ 千万不要 bind 0.0.0.0：6379 无认证暴露到公网等于把整个
#    用户库、密钥库和计费流水交出去。
bind 127.0.0.1 -::1
port 6379

protected-mode yes

# ---------------------------------------------------------------------
# 2. 认证
# ---------------------------------------------------------------------
# 密码写进 .env.production 的 REDIS_URL：
#   REDIS_URL="redis://:<这里的密码>@127.0.0.1:6379"
# 生成：openssl rand -hex 32
requirepass <在此粘贴生成的密码>

# ---------------------------------------------------------------------
# 3. 淘汰策略 —— 这条最关键
# ---------------------------------------------------------------------
# RelayAB 用 Redis 存的是权威数据，不是缓存：用户、API 密钥、
# 余额、用量流水、配额都直接落在这里。
#
# 如果配成 allkeys-lru 或 allkeys-random，内存一到上限 Valkey 会
# 静默淘汰这些记录 —— 不报错、接口照常返回，但配额和流水会凭空消失。
#
# 保持 noeviction：写不进去就明确报错，这比悄悄丢数据安全得多。
maxmemory-policy noeviction

# 按机器内存设置。留空 = 不限制。
# 建议留出余量，不要把 maxmemory 设成物理内存的 100%，
# 否则 Valkey 自身的开销会触发 OOM Killer 把 Node 进程一起带走。
# maxmemory 1gb

# ---------------------------------------------------------------------
# 4. 持久化
# ---------------------------------------------------------------------
# AOF everysec：最多丢失约 1 秒的用量记录，代价远低于 RDB 间隔快照。
appendonly yes
appendfsync everysec

# RDB 保留作为 AOF 异常时的兜底
save 900 1
save 300 10
save 60 10000

# ---------------------------------------------------------------------
# 5. 运维
# ---------------------------------------------------------------------
# 只对本机应用可见，无需 ACL。
loglevel notice
logfile /var/log/valkey/valkey.log
dir /var/lib/valkey

# ---------------------------------------------------------------------
# 6. 备份
# ---------------------------------------------------------------------
# 用量流水属于业务账目，建议加一条日备：
#
#   sudo crontab -e
#   17 3 * * * valkey-cli -a '<密码>' --rdb /var/backups/valkey-$(date +\%F).rdb
#
# 从 Upstash 迁移历史数据时，用同样方式导出再导入即可
# （存进去的就是普通字符串，Valkey 原样可读，无需任何转换）。
