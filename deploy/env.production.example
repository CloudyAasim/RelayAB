# =====================================================================
# RelayAB — 生产环境变量（自托管 / Debian）
# =====================================================================
#
# 复制为 .env.production，并 chmod 600。
# systemd 的 EnvironmentFile 不支持 export 前缀，也不支持变量展开，
# 直接写 KEY=VALUE。
#
# 改动后执行：sudo systemctl restart relayab

# ---------------------------------------------------------------------
# 1. 必需
# ---------------------------------------------------------------------

# 主密钥：用于管理员登录、Session 加密、上游 API 密钥加密。
# 生成：openssl rand -hex 32
#
# ⚠️ 轮换会让所有存量 Session 失效，并使已加密的上游密钥无法解密。
#    轮换前先固定 RELAY_MASTER_KEY_HEX，或改用 scripts/rotate-master-key.ts。
#
# 用 Dokku 部署时**不要设这一项** —— app.json 里的 "generator": "secret"
# 会让平台在首次部署时自动生成，你根本不需要手写。
RELAY_AUTH="<在此粘贴 openssl rand -hex 32 的输出>"

# ---------------------------------------------------------------------
# 2. 数据库
# ---------------------------------------------------------------------
#
# 不需要任何数据库服务。SQLite 是 Node 24 内置模块，数据库就是一个文件。
#
# 留空则默认写到 <工作目录>/data/relayab.db。生产环境建议显式指定，
# 把数据库放在发布目录之外 —— 这样 git pull 和重新构建都碰不到它。
RELAY_DB_PATH="/var/lib/relayab/relayab.db"

# ---------------------------------------------------------------------
# 3. 对外地址
# ---------------------------------------------------------------------
#
# 生产环境强烈建议显式设置。留空时依赖 nginx 转发的
# x-forwarded-proto / x-forwarded-host 推导，功能正常但多一层隐式依赖。
RELAY_PUBLIC_URL="https://api.aasim.l.cd"

# ---------------------------------------------------------------------
# 4. 部署标识
# ---------------------------------------------------------------------
#
# 记录当前运行的版本，会出现在 /healthz 的 revision 字段。
# 用 Dokku 部署时不需要设 —— Dokku 会自动注入 DOKKU_GIT_REV。
RELAY_BUILD_ID="v179"

# ---------------------------------------------------------------------
# 5. 可选配置（都有安全的默认值）
# ---------------------------------------------------------------------

NODE_ENV="production"

# 管理员用户名
# RELAY_ADMIN_USERNAME="admin"

# 界面语言：zh-CN 或 en。用户可在页脚随时切换
# RELAY_DEFAULT_LOCALE="zh-CN"

# 固定 AES 主密钥，这样修改 RELAY_AUTH 时不会使已存储的上游密钥失效
# RELAY_MASTER_KEY_HEX="<64位十六进制字符>"

# 上游提供商：设置后会在首次启动时自动创建
# OPENAI_KEYS="sk-xxx,sk-yyy"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# ANTHROPIC_KEYS="sk-ant-xxx"
# ANTHROPIC_BASE_URL="https://api.anthropic.com"

# 页脚显示的仓库链接
# NEXT_PUBLIC_REPOSITORY_URL="https://github.com/CloudyAasim/RelayAB"
