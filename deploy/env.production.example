# =====================================================================
# RelayAB — 生产环境变量（自托管 / Debian）
# =====================================================================
#
# 复制为 /opt/relayab/.env.production，并 chmod 600。
# systemd 的 EnvironmentFile 不支持 export 前缀，也不支持变量展开，
# 直接写 KEY=VALUE。
#
# 改动后执行：sudo systemctl restart relayab

# ---------------------------------------------------------------------
# 1. 必需
# ---------------------------------------------------------------------

# 主密钥：用于管理员登录、Session 加密、上游 API 密钥加密。
# 生成：openssl rand -hex 32
#
# ⚠️ 轮换会让所有存量 Session 失效，并使已加密的上游密钥无法解密。
#    轮换前先固定 RELAY_MASTER_KEY_HEX，或改用 scripts/rotate-master-key.ts。
RELAY_AUTH="<在此粘贴 openssl rand -hex 32 的输出>"

# ---------------------------------------------------------------------
# 2. 数据库（自建 Valkey / Redis）
# ---------------------------------------------------------------------
#
# 连接串格式：redis://[:密码]@主机:端口
# 本机 Valkey 默认：redis://:<requirepass 里的密码>@127.0.0.1:6379
#
# 设置了 REDIS_URL 就会走 ioredis 的 TCP 通道，优先级高于
# UPSTASH_REDIS_REST_*。两者不必同时存在。
#
# 用 rediss:// 表示启用 TLS 的端点。
REDIS_URL="redis://:<Valkey requirepass>@127.0.0.1:6379"

# --- 仅当仍使用 Upstash 托管版时才需要 ---------------------------------
# UPSTASH_REDIS_REST_URL="https://<your-db>.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="<your-token>"

# ---------------------------------------------------------------------
# 3. 对外地址
# ---------------------------------------------------------------------
#
# 生产环境强烈建议显式设置。留空时依赖 nginx 转发的
# x-forwarded-proto / x-forwarded-host 推导，功能正常但多一层隐式依赖。
RELAY_PUBLIC_URL="https://api.aasim.l.cd"

# ---------------------------------------------------------------------
# 4. 部署标识
# ---------------------------------------------------------------------
#
# 记录当前运行的版本，会出现在 /healthz 的 revision 字段。
# 自托管环境下不存在 VERCEL_GIT_COMMIT_SHA，只能靠这个字段判断
# 「线上跑的到底是哪一版」。建议由部署脚本写入：
#   echo "RELAY_BUILD_ID=$(git rev-parse --short HEAD)" >> .env.production
RELAY_BUILD_ID="v178"

# ---------------------------------------------------------------------
# 5. 可选配置（都有安全的默认值）
# ---------------------------------------------------------------------

NODE_ENV="production"

# 内存模式仅用于本地开发；生产必须为 0，否则数据不会落盘。
EMULATE_VERCEL_LOCAL="0"

# 固定 AES 主密钥，这样修改 RELAY_AUTH 时不会使已存储的上游密钥失效。
# RELAY_MASTER_KEY_HEX="<64位十六进制字符>"

# 默认管理员用户名。
# RELAY_ADMIN_USERNAME="admin"

# 界面语言：zh-CN 或 en。用户可在页脚随时切换。
# RELAY_DEFAULT_LOCALE="zh-CN"

# 上游提供商：设置后会在首次启动时自动创建
# OPENAI_KEYS="sk-xxx,sk-yyy"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# ANTHROPIC_KEYS="sk-ant-xxx"
# ANTHROPIC_BASE_URL="https://api.anthropic.com"

# 页脚显示的仓库链接
# NEXT_PUBLIC_REPOSITORY_URL="https://github.com/CloudyAasim/RelayAB"
