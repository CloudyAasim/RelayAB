# local env files
# Must be the ONLY env file that gets tracked: copy → .env (which IS ignored).
# Next.js convention files (.env.development / .env.production / .env.test)
# are also ignored so they cannot leak real keys by accident.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# emulator runtime
.emulate/

# Vercel
.vercel

# tooling caches (defense in depth)
.cache/
.turbo/

# local SQLite database (the default RELAY_DB_PATH lives here).
# Users, keys, balances and usage logs are in this file — it must never be
# committed. Back it up, don't track it.
data/
*.db
*.db-wal
*.db-shm

# scratch dirs used by the test suite
node_modules/.tmp-relayab-test/
